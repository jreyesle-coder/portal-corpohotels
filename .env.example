# Copiar a .env para desarrollo local. En Azure, estas mismas claves son App Settings
# y los secretos se declaran como referencias de Key Vault:
#   DATABASE_URL=@Microsoft.KeyVault(SecretUri=https://<boveda>.vault.azure.net/secrets/database-url/)
# Valores de desarrollo, alineados con docker-compose.yml. No usar en ningún otro entorno.

SITE_URL=http://localhost:3000

# PostgreSQL (servicio "postgres" de docker-compose; dentro de la red de Docker el host es "postgres")
DATABASE_URL=postgres://portal:portal_dev@localhost:5432/portal

# Azurite (cuenta de desarrollo pública y documentada de Azurite)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=medios

# Mailpit (bandeja en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-responder@corphotels.gob.do

# Matomo (http://localhost:8080; el ID se crea en el asistente de instalación)
MATOMO_URL=http://localhost:8080
MATOMO_SITE_ID=1

# CMS (Payload). Clave de al menos 32 caracteres; en Azure, secreto en Key Vault.
PAYLOAD_SECRET=cambie-esta-clave-de-desarrollo-por-una-aleatoria
AZURE_STORAGE_BASE_URL=http://localhost:10000/devstoreaccount1
# 1 = sirve el panel /gestion (app privada del CMS); 0 = portal público sin panel ni API de escritura.
PANEL_HABILITADO=1

# Inicio de sesión del CMS (OpenID Connect).
# Local: simulador de Entra ID en Docker (servicio "entra-simulado").
# Azure: OIDC_ISSUER=https://login.microsoftonline.com/<id-del-inquilino>/v2.0 y el registro de
# aplicación del CMS (ver docs/entra-id.md).
OIDC_ISSUER=http://localhost:8090/entra
OIDC_CLIENT_ID=cms-corphotels-local
OIDC_CLIENT_SECRET=simulado
# amr = el token debe traer "mfa" en el reclamo amr; acrs:c1 = contexto de autenticación c1.
OIDC_VERIFICACION_MFA=amr
